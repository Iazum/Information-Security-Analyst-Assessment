<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>



<group name="local,ransomware,syscheck,">

  <!-- Mass file modification on one agent -->
  <rule id="100100" level="12" frequency="30" timeframe="60">
    <if_matched_sid>550</if_matched_sid>
    <same_agent />
    <description>Possible ransomware: 30+ files modified in 60 seconds</description>
    <mitre><id>T1486</id></mitre>
  </rule>

  <!-- Files created with known ransomware extensions -->
  <rule id="100101" level="13">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i)\.(locked|lockbit|encrypted|crypt|crypted|enc|wncry|conti)$</field>
    <description>Possible ransomware: file with encrypted-file extension created</description>
    <mitre><id>T1486</id></mitre>
  </rule>

  <!-- Ransom note filenames -->
  <rule id="100102" level="13">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i)(HOW_TO_DECRYPT|DECRYPT_INSTRUCTIONS|RESTORE_FILES|README_TO_DECRYPT)</field>
    <description>Possible ransomware: ransom-note style file created</description>
    <mitre><id>T1486</id></mitre>
  </rule>

</group>


<group name="local,shadow_ai,">

  <rule id="100200" level="0">
    <decoded_as>custom-dnsmasq</decoded_as>
    <description>DNS query logged by dnsmasq</description>
  </rule>

  <!-- Consumer LLM domain queried by a non-approved host -->
  <rule id="100201" level="8">
    <if_sid>100200</if_sid>
    <field name="dns.query" type="pcre2">(?i)(^|\.)(chatgpt\.com|openai\.com|claude\.ai|gemini\.google\.com|copilot\.microsoft\.com|perplexity\.ai|deepseek\.com|poe\.com|character\.ai|grok\.com)$</field>
    <list field="srcip" lookup="not_address_match_key">etc/lists/approved-ai-hosts</list>
    <description>Shadow AI: consumer LLM domain queried ($(dns.query)) from $(srcip)</description>
    <mitre><id>T1567</id></mitre>
  </rule>

  <!-- Heavy usage from one host -->
  <rule id="100202" level="10" frequency="20" timeframe="600">
    <if_matched_sid>100201</if_matched_sid>
    <same_srcip />
    <description>Shadow AI: heavy consumer LLM usage from $(srcip) (20+ queries in 10 min)</description>
  </rule>

